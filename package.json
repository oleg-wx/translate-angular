{
  "name": "simply-translate-angular",
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "build:dev": "ng build translate --configuration development && npm run copy_readme && npm run copy_npmrc",
    "build:prod": "ng build translate --configuration production && npm run copy_readme && npm run copy_npmrc",
    "build:prod:patch": "cd ./projects/translate && npm --no-git-tag-version version patch && cd ../.. && npm run build:prod",
    "publish:prod": "npm run build:prod && cd dist/translate && npm publish && cd ../..",
    "publish:prod:patch": "npm run build:prod:patch && cd dist/translate && npm publish && cd ../..",
    "build:demo:dev": "ng build --configuration development",
    "build:demo:prod": "node --max-old-space-size=8192 ./node_modules/@angular/cli/bin/ng build --configuration production --aot",
    "start:demo": "ng serve --port 4801 --live-reload false",
    "restart:all": "npm run build:library:prod && npm run start:demo",
    "test": "ng test translate",
    "e2e": "ng e2e",
    "copy_readme": "copyfiles ./README.md dist/translate",
    "copy_npmrc": "copyfiles -f ./projects/translate/.npmrc dist/translate"
  },
  "dependencies": {
    "@angular/animations": "^17.3.12",
    "@angular/cdk": "^17.3.0",
    "@angular/cli": "^17.3.17",
    "@angular/common": "^17.3.12",
    "@angular/compiler": "^17.3.12",
    "@angular/compiler-cli": "^17.3.12",
    "@angular/core": "^17.3.12",
    "@angular/forms": "^17.3.12",
    "@angular/language-service": "^17.3.12",
    "@angular/material": "^17.3.0",
    "@angular/platform-browser": "^17.3.12",
    "@angular/platform-browser-dynamic": "^17.3.12",
    "@angular/router": "^17.3.12",
    "rxjs": "^7.3.0",
    "simply-translate": "^0.20.0",
    "tslib": "^2.3.1",
    "typescript": "5.4.5",
    "zone.js": "~0.14.10"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^17.3.17",
    "@types/jasmine": "~6.0.0",
    "@types/jasminewd2": "~2.0.10",
    "@types/node": "~18.11.7",
    "jasmine-core": "~6.0.0",
    "jasmine-spec-reporter": "~7.0.0",
    "karma": "~6.4.2",
    "karma-chrome-launcher": "~3.1.0",
    "karma-coverage-istanbul-reporter": "~3.0.3",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "^2.2.0",
    "ng-packagr": "^17.3.0",
    "protractor": "~7.0.0",
    "tslint": "~6.1.3",
    "core-js": "^3.26.0",
    "copyfiles": "^2.4.1"
  }
}
