{
  "name": "simply-translate-angular",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build:translate": "ng build translate --configuration production && copyfiles -f projects/translate/CHANGELOG.md LICENSE dist/translate",
    "build:proxy": "ng build proxy --configuration production && copyfiles -f projects/proxy/CHANGELOG.md LICENSE dist/proxy",
    "build:prod": "npm run build:translate && npm run build:proxy",
    "build:dev": "ng build translate && ng build proxy --configuration development",
    "publish:translate": "npm run build:translate && npm publish ./dist/translate",
    "publish:proxy": "npm run build:prod && npm publish ./dist/proxy",
    "build:demo:dev": "ng build --configuration development",
    "build:demo:prod": "node --max-old-space-size=8192 ./node_modules/@angular/cli/bin/ng build --configuration production --aot",
    "start:demo": "ng serve --port 4800 --live-reload false",
    "restart:all": "npm run build:prod && npm run start:demo",
    "test": "npm run test:translate && npm run build:translate && npm run test:proxy",
    "test:translate": "ng test translate --watch=false --browsers=ChromeHeadless",
    "test:proxy": "ng test proxy --watch=false --browsers=ChromeHeadless",
    "test:watch": "ng test translate",
    "e2e": "ng e2e"
  },
  "dependencies": {
    "@angular/animations": "^17.3.12",
    "@angular/cdk": "^17.3.0",
    "@angular/cli": "^17.3.17",
    "@angular/common": "^17.3.12",
    "@angular/compiler": "^17.3.12",
    "@angular/compiler-cli": "^17.3.12",
    "@angular/core": "^17.3.12",
    "@angular/forms": "^17.3.12",
    "@angular/language-service": "^17.3.12",
    "@angular/material": "^17.3.0",
    "@angular/platform-browser": "^17.3.12",
    "@angular/platform-browser-dynamic": "^17.3.12",
    "@angular/router": "^17.3.12",
    "rxjs": "^7.3.0",
    "simply-translate": "^1.0.0",
    "tslib": "^2.3.1",
    "typescript": "5.4.5",
    "zone.js": "~0.14.10"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^17.3.17",
    "@angular/compiler-cli": "^17.3.0",
    "@types/jasmine": "~6.0.0",
    "@types/jasminewd2": "~2.0.10",
    "@types/node": "~18.11.7",
    "copyfiles": "^2.4.1",
    "core-js": "^3.26.0",
    "jasmine-core": "~6.0.0",
    "jasmine-spec-reporter": "~7.0.0",
    "karma": "~6.4.2",
    "karma-chrome-launcher": "~3.1.0",
    "karma-coverage": "^2.2.1",
    "karma-coverage-istanbul-reporter": "~3.0.3",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "^2.2.0",
    "ng-packagr": "^17.3.0",
    "protractor": "~7.0.0",
    "tslint": "~6.1.3",
    "typescript": "~5.4.2"
  }
}
