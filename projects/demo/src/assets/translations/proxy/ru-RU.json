{
  "proxy": {
    "welcome_to_app": "[Proxy] Добро пожаловть в Тестовое приложение",
    "hello_user": "[Proxy] Привет, $&{user?namespace.user}!",

    "hello_world": "[Proxy] Привет мир!",
    "goodbye_world": {
      "value": "[Proxy] Пока мир",
      "description": "тест"
    },

    "namespace": {
      "value": "[Proxy] пространство имен",
      "hello_user": "[Proxy] Снова здравствуй, $&{user?namespace.user}!",
      "user": "[Proxy] Пользователь"
    },

    "i_have_been_here_count": {
      "value": "[Proxy] $!{count} ${days}",
      "cases": {
        "count": [
          ["!!", "Я уже был здесь ${count}"],
          ["!", "Я не был здесь"]
        ]
      },
      "plural": {
        "count": [
          ["=0", "... ващет ни разу"],
          ["=1", "раз"],
          ["=2", "дважды"],
          ["in [3,4,5]", "несколько раз"],
          ["<100", "много раз"],
          ["_", "$# раз(а)"]
        ],
        "days": [
          ["=0", "сегодня"],
          ["=1", "за день"],
          ["<4", "пару дней"],
          ["_", "за долго"]
        ]
      }
    },

    "day_since_new_year": {
      "value": "[Proxy] ${days}",
      "plural": {
        "days": [
          ["=1", "Прошел день с Нового Года"],
          ["<1", "Это Новый Год"],
          [">365", "Прошел уже год с начала того года"],
          [">181", "Прошло уже полгода с начала года"],
          [">93", "Более трех месяцев прошло с Нового Года"],
          ["_", "Уже прошло $# дней с начала года"]
        ]
      }
    },

    "for_fallback": "[Proxy] для Фолбэка",

    "same_key": "[Proxy] Same in the Root"
  }
}
